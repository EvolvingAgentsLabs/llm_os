# LLM-OS v0.01 ISA Grammar
# Target tokenizer: Qwen 3 2B (bootstrap — opcodes are string patterns,
# tokenized as multi-token sequences). Kernel-native single-token version
# is produced after Month 2 fine-tune; see isa-spec.md §5.
#
# Invariants enforced structurally:
#   I1. <|halt|> legal only at loop depth 0 (top-level program rule).
#   I2. Every <|loop|> matched by <|break|> inside loop-body.
#   I3. <|break|> legal only inside loop-body.
#   I4. Syscall result-blocks follow read/call/wait/fault/policy.
#   I5. <|write|> is acknowledged by <|ack|>.

root ::= program

program ::= top-stmt* halt-stmt

# --- statements legal at loop depth 0 (no <|break|>, <|halt|> allowed) ---
top-stmt ::= read-stmt
           | write-stmt
           | call-stmt
           | yield-stmt
           | fork-stmt
           | wait-stmt
           | loop-block
           | think-block
           | commit-stmt
           | fault-stmt
           | policy-stmt

# --- statements legal inside a loop (adds <|break|>, forbids <|halt|>) ---
loop-stmt ::= read-stmt
            | write-stmt
            | call-stmt
            | yield-stmt
            | fork-stmt
            | wait-stmt
            | loop-block
            | think-block
            | commit-stmt
            | fault-stmt
            | policy-stmt
            | break-stmt

# --- opcodes ---

read-stmt    ::= "<|read|>fd=" integer " len=" integer nl result-block
write-stmt   ::= "<|write|>fd=" integer " " json nl ack
call-stmt    ::= "<|call|>" cart-name "." method-name ws json ws "<|/call|>" nl result-block
yield-stmt   ::= "<|yield|>" nl
fork-stmt    ::= "<|fork|>goal=" label nl
wait-stmt    ::= "<|wait|>fd=" integer nl result-block
break-stmt   ::= "<|break|>" nl
halt-stmt    ::= "<|halt|>status=" status nl
think-block  ::= "<|think|>" safe-text "<|/think|>" nl
commit-stmt  ::= "<|commit|>" json nl
fault-stmt   ::= "<|fault|>" json nl result-block
policy-stmt  ::= "<|policy|>" nl result-block

loop-block   ::= "<|loop|>goal=" label nl loop-stmt* break-stmt

# --- daemon-injected blocks; part of grammar so re-prefill validates ---

result-block ::= "<|result|>" safe-text "<|/result|>" nl
ack          ::= "<|ack|>" nl

# --- terminals ---

cart-name    ::= [a-z] [a-z0-9_]*
method-name  ::= [a-z] [a-z0-9_]*
label        ::= [a-zA-Z0-9_-]+
status       ::= "success" | "failure" | "partial"
integer      ::= [0-9]+

# JSON — permissive; per-cartridge schemas validated at runtime in the I/O daemon.
json         ::= object | array | string | number | "true" | "false" | "null"
object       ::= "{" ws ( kv ( ws "," ws kv )* )? ws "}"
kv           ::= string ws ":" ws json
array        ::= "[" ws ( json ( ws "," ws json )* )? ws "]"
string       ::= "\"" string-char* "\""
string-char  ::= [^"\\] | "\\" ["\\/bfnrt]
number       ::= "-"? [0-9]+ ( "." [0-9]+ )?

# Free text inside think/result blocks. Disallow "<" so we cannot
# accidentally swallow another opcode inside prose.
safe-text    ::= [^<]*

ws           ::= [ \t]*
nl           ::= "\n"
