{
  "name": "roclaw",
  "version": "0.0.1",
  "description": "RoClaw 6-byte UDP bytecode bridge. Built-in handler — methods compile to BytecodeFrames via the Rust port of bytecode_compiler.ts and are sent over UDP to LLM_OS_ROCLAW_ADDR (default 127.0.0.1:4210). 13 opcodes per RoClaw v1.1.",
  "allowed_opcodes": ["call"],
  "preferred_tier": "local",
  "methods": {
    "forward":      { "args_schema": "schemas/motion.args.schema.json",     "description": "MOVE_FORWARD (0x01). Args: left, right (bytes 0-255)." },
    "backward":     { "args_schema": "schemas/motion.args.schema.json",     "description": "MOVE_BACKWARD (0x02)." },
    "turn_left":    { "args_schema": "schemas/motion.args.schema.json",     "description": "TURN_LEFT (0x03), differential." },
    "turn_right":   { "args_schema": "schemas/motion.args.schema.json",     "description": "TURN_RIGHT (0x04), differential." },
    "rotate_cw":    { "args_schema": "schemas/rotate.args.schema.json",     "description": "ROTATE_CW (0x05). Args: degrees, speed." },
    "rotate_ccw":   { "args_schema": "schemas/rotate.args.schema.json",     "description": "ROTATE_CCW (0x06)." },
    "stop":         { "args_schema": "schemas/empty.args.schema.json",      "description": "STOP (0x07)." },
    "get_status":   { "args_schema": "schemas/empty.args.schema.json",      "description": "GET_STATUS (0x08)." },
    "set_speed":    { "args_schema": "schemas/motion.args.schema.json",     "description": "SET_SPEED (0x09)." },
    "move_steps":   { "args_schema": "schemas/motion.args.schema.json",     "description": "MOVE_STEPS (0x0A)." },
    "move_steps_r": { "args_schema": "schemas/motion.args.schema.json",     "description": "MOVE_STEPS_R (0x0B)." },
    "led_set":      { "args_schema": "schemas/led.args.schema.json",        "description": "LED_SET (0x10). Args: led, value." },
    "reset":        { "args_schema": "schemas/empty.args.schema.json",      "description": "RESET (0xFE)." }
  }
}
