{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalyzeLoadArgs",
  "type": "object",
  "required": ["load_profile"],
  "properties": {
    "load_profile": {
      "type": "object",
      "required": ["voltage_v", "rooms"],
      "properties": {
        "voltage_v":    { "type": "integer", "minimum": 110, "maximum": 400 },
        "frequency_hz": { "type": "integer", "enum": [50, 60] },
        "rooms":        { "type": "array", "minItems": 1 }
      }
    }
  },
  "additionalProperties": false
}
