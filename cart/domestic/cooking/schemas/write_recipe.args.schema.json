{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WriteRecipeArgs",
  "type": "object",
  "required": ["meal_name", "slot"],
  "properties": {
    "meal_name":   { "type": "string", "minLength": 2 },
    "slot":        { "type": "string", "enum": ["breakfast", "lunch", "dinner"] },
    "servings":    { "type": "integer", "minimum": 1, "maximum": 20 },
    "constraints": { "type": "string" }
  },
  "additionalProperties": false
}
