{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildShoppingListArgs",
  "type": "object",
  "required": ["menu"],
  "properties": {
    "menu": {
      "type": "object",
      "required": ["household_size", "days"],
      "properties": {
        "household_size": { "type": "integer", "minimum": 1 },
        "days": { "type": "array", "minItems": 7, "maxItems": 7 }
      }
    }
  },
  "additionalProperties": false
}
