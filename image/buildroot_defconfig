# ──────────────────────────────────────────────────────────────────────
# LLM-OS Buildroot defconfig — Raspberry Pi 5 (aarch64)
#
# Produces a bootable SD card image that runs llama-server + iod as
# PID 1. Nothing else. No package manager, no display, no desktop.
#
# Usage:
#   cp image/buildroot_defconfig <buildroot>/configs/llm_os_rpi5_defconfig
#   cd <buildroot>
#   make llm_os_rpi5_defconfig
#   make -j$(nproc)
#
# Output: output/images/sdcard.img
# ──────────────────────────────────────────────────────────────────────

# ── Target ───────────────────────────────────────────────────────────
BR2_aarch64=y
BR2_cortex_a76=y
BR2_ARM_FP_ARMV8=y

# ── Toolchain ────────────────────────────────────────────────────────
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_6=y

# ── Kernel ───────────────────────────────────────────────────────────
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/raspberrypi/linux/archive/refs/tags/stable_20241008.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b"

# Kernel features we need:
#   - NEON SIMD (for llama.cpp ggml)        → ARM64 default
#   - mmap (for GGUF zero-copy loading)     → always on
#   - loopback networking                   → always on
#   - SD/MMC driver (mmcblk0)               → bcm2712 defconfig
#   - Watchdog (bcm2835-wdt)                → bcm2712 defconfig
#   - Ethernet (bcmgenet)                   → bcm2712 defconfig
#   - WiFi (brcmfmac, optional)             → bcm2712 defconfig
#   - UART (ttyAMA0 for serial console)     → bcm2712 defconfig

# ── Bootloader ───────────────────────────────────────────────────────
# Pi 5 boots via its own firmware (start4.elf + fixup4.dat).
# No U-Boot needed — kernel is loaded directly by the GPU firmware.
BR2_TARGET_RPI_FIRMWARE=y
BR2_TARGET_RPI_FIRMWARE_VARIANT_PI5=y

# ── Filesystem ───────────────────────────────────────────────────────
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="64M"

# Read-only root for reliability (power-cut safe)
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW=n

# ── Init system ──────────────────────────────────────────────────────
# No systemd, no openrc. Our /init script IS PID 1.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y

# ── Packages ─────────────────────────────────────────────────────────
# Minimal. We statically link llama-server and iod.
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="package/busybox/busybox.config"

# Networking (for cloud fallback)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y

# OpenBLAS (optional — may improve GEMM performance on Cortex-A76)
# BR2_PACKAGE_OPENBLAS=y
# BR2_PACKAGE_OPENBLAS_DEFAULT_NUM_THREADS=4

# ── Overlay ──────────────────────────────────────────────────────────
# Our /init, /etc/isa.gbnf, /etc/cart/, /usr/bin/{bootloader,iod,llama-server}
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_LLM_OS_PATH)/overlay"

# ── SD card image layout ─────────────────────────────────────────────
BR2_TARGET_ROOTFS_EXT2_GENIMAGE=y
# genimage.cfg is provided separately (see image/genimage.cfg)
