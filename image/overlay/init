#!/bin/sh
# ──────────────────────────────────────────────────────────────────────
# LLM-OS v0.01 — init (PID 1)
#
# This replaces systemd/openrc. The entire machine exists to sample
# tokens constrained by the ISA grammar.
#
# Partition layout (set by build.sh):
#   /dev/mmcblk0p1  boot    (FAT32, kernel + dtbs)
#   /dev/mmcblk0p2  rootfs  (ext4,  read-only squashfs in release)
#   /dev/mmcblk0p3  model   (ext4,  GGUF + goal.txt + traces/)
# ──────────────────────────────────────────────────────────────────────

# ── 1. Mount virtual filesystems ─────────────────────────────────────
mount -t proc     proc  /proc
mount -t sysfs    sys   /sys
mount -t devtmpfs dev   /dev
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts   devpts /dev/pts
mount -t tmpfs    tmpfs  /run
mount -t tmpfs    tmpfs  /tmp

# ── 2. Kernel messages to UART (ttyAMA0 = Pi 5 debug UART) ──────────
# Redirect kernel printk to serial so hardware issues are visible
# without a display.
if [ -e /dev/ttyAMA0 ]; then
    echo 7 > /proc/sys/kernel/printk
    exec 2>/dev/ttyAMA0
    echo "[llm-os] init starting" >&2
fi

# ── 3. Hostname ──────────────────────────────────────────────────────
hostname llm-os

# ── 4. Networking ────────────────────────────────────────────────────
# Loopback is mandatory (bootloader talks to llama-server over 127.0.0.1)
ip link set lo up
ip addr add 127.0.0.1/8 dev lo

# Ethernet (optional — needed for cloud fallback / dual-brain)
if [ -e /sys/class/net/eth0 ]; then
    ip link set eth0 up
    udhcpc -i eth0 -s /etc/udhcpc.script -b -q 2>/dev/null &
fi

# WiFi (optional — needs wpa_supplicant in overlay)
if [ -e /sys/class/net/wlan0 ] && [ -f /etc/wpa_supplicant.conf ]; then
    wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf
    udhcpc -i wlan0 -s /etc/udhcpc.script -b -q 2>/dev/null &
fi

# ── 5. Mount model partition ────────────────────────────────────────
mkdir -p /model
mount -o ro /dev/mmcblk0p3 /model
if [ $? -ne 0 ]; then
    echo "[llm-os] FATAL: cannot mount model partition" >&2
    exec sh  # drop to emergency shell
fi

# Make a writable overlay for traces (tmpfs backed — flush to SD on halt)
mkdir -p /run/traces
ln -sf /run/traces /model/traces 2>/dev/null

# ── 6. Hardware watchdog ─────────────────────────────────────────────
# Pi 5 has a bcm2835-wdt. If llama-server or iod die, the board reboots
# after 15 seconds.
if [ -e /dev/watchdog ]; then
    echo "[llm-os] arming hardware watchdog (15s)" >&2
    # Background feeder — killed if init exits (triggering reboot)
    (while true; do echo V > /dev/watchdog; sleep 5; done) &
    WATCHDOG_PID=$!
fi

# ── 7. Resolve model file ───────────────────────────────────────────
MODEL_FILE=""
for f in /model/*.gguf; do
    [ -f "$f" ] && MODEL_FILE="$f" && break
done

if [ -z "$MODEL_FILE" ]; then
    echo "[llm-os] FATAL: no .gguf file found on model partition" >&2
    exec sh
fi

# Read config overrides if present
PORT="${LLM_OS_PORT:-8080}"
CTX="${LLM_OS_CTX:-32768}"
PARALLEL="${LLM_OS_PARALLEL:-1}"

if [ -f /model/config.sh ]; then
    . /model/config.sh
fi

echo "[llm-os] model=$MODEL_FILE port=$PORT ctx=$CTX parallel=$PARALLEL" >&2

# ── 8. Boot llama-server via bootloader ──────────────────────────────
/usr/bin/bootloader \
    --model "$MODEL_FILE" \
    --port "$PORT" \
    --ctx-size "$CTX" \
    --server-bin /usr/bin/llama-server

if [ $? -ne 0 ]; then
    echo "[llm-os] FATAL: bootloader failed" >&2
    exec sh
fi

SERVER_PID=$(cat /proc/$(pgrep -f llama-server)/stat 2>/dev/null | cut -d' ' -f1)
echo "[llm-os] llama-server running (pid=$SERVER_PID)" >&2

# ── 9. Read goal ─────────────────────────────────────────────────────
GOAL="await"
if [ -f /model/goal.txt ]; then
    GOAL=$(cat /model/goal.txt)
fi

# ── 10. Launch iod (becomes the main process) ────────────────────────
echo "[llm-os] starting iod — goal: $GOAL" >&2

exec /usr/bin/iod \
    --server "http://127.0.0.1:${PORT}" \
    --grammar /etc/isa.gbnf \
    --cart /etc/cart \
    --goal "$GOAL"
