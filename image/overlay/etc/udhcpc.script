#!/bin/sh
# Minimal udhcpc callback for busybox DHCP client.
# Sets IP, gateway, DNS from DHCP lease.

case "$1" in
    bound|renew)
        ip addr flush dev "$interface"
        ip addr add "$ip/$mask" dev "$interface"
        [ -n "$router" ] && ip route add default via "$router" dev "$interface"
        if [ -n "$dns" ]; then
            : > /etc/resolv.conf
            for d in $dns; do
                echo "nameserver $d" >> /etc/resolv.conf
            done
        fi
        ;;
    deconfig)
        ip addr flush dev "$interface"
        ;;
esac
